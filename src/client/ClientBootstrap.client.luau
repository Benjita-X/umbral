-- ClientBootstrap: arranca los controladores del jugador local en orden.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"):WaitForChild("MovementConfig"))
local controllers = script.Parent:WaitForChild("Controllers")

local InputController = require(controllers:WaitForChild("InputController"))
local MovementController = require(controllers:WaitForChild("MovementController"))
local CombatController = require(controllers:WaitForChild("CombatController"))
local CameraController = require(controllers:WaitForChild("CameraController"))
local EnemyController = require(controllers:WaitForChild("EnemyController"))
local CombatHUD = require(controllers:WaitForChild("CombatHUD"))
local VitalsHUD = require(controllers:WaitForChild("VitalsHUD"))
local DebugHUD = require(controllers:WaitForChild("DebugHUD"))
local PositionReporter = require(controllers:WaitForChild("PositionReporter"))
local EcoController = require(controllers:WaitForChild("EcoController"))
local SkillBarHUD = require(controllers:WaitForChild("SkillBarHUD"))
local GanchoController = require(controllers:WaitForChild("GanchoController"))
local FijarObjetivoController = require(controllers:WaitForChild("FijarObjetivoController"))
local EfectosMovimiento = require(controllers:WaitForChild("EfectosMovimiento"))
local MenuController = require(controllers:WaitForChild("MenuController"))
local MovementAnimator = require(controllers:WaitForChild("MovementAnimator"))
local TutorialController = require(controllers:WaitForChild("TutorialController"))
local AmbienteController = require(controllers:WaitForChild("AmbienteController"))

MovementController.Start(InputController)
CombatController.Start(InputController, MovementController)
CameraController.Start(MovementController, InputController)
EnemyController.Start()
CombatHUD.Start(CombatController)
VitalsHUD.Start(CombatController)
if Config.DebugHUD then
	DebugHUD.Start(MovementController, CombatController)
end
PositionReporter.Start()
EcoController.Start(InputController, MovementController, CombatController, CameraController)
task.spawn(SkillBarHUD.Start, EcoController)
task.spawn(GanchoController.Start, InputController, MovementController, CombatController)
task.spawn(FijarObjetivoController.Start, InputController, MovementController, CameraController)
EfectosMovimiento.Start(MovementController, CameraController)
MenuController.Start(MovementController, CombatController, DebugHUD, TutorialController, EcoController)
MovementAnimator.Start(MovementController)
task.spawn(TutorialController.Start, MovementController, CombatController, EcoController)
task.spawn(AmbienteController.Start)
InputController.Start()

print("[UMBRAL] Cliente listo")
